{
  "name": "youoke-plugin",
  "version": "5.5.303",
  "description": "YouOke AI Vocal Separator Desktop Plugin",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.okeforyou.plugin",
    "productName": "YouOke Plugin",
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    },
    "win": {
      "target": "nsis"
    },
    "protocols": {
      "name": "YouOke Protocol",
      "schemes": [
        "youoke"
      ]
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "okeforyou",
        "repo": "youoke",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "YouOke",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
