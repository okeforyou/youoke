rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 🛡️ Global Helper Functions
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 1. Super Admin (Hardcoded UIDs) - Always Allowed, No DB Lookup Cost
    function isSuperAdmin() {
      return request.auth.uid == 'P6r7fkMfvherVvzXV35NPhF5TVw2' || 
             request.auth.uid == 'I4UmiD5gNDMY04LkvtuEIBtrEkK2';
    }

    // 2. DB Admin (Role Check) - Costs 1 Read
    function isDbAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'owner'];
    }

    // Combined Check (Use SuperAdmin first to short-circuit)
    function isAdmin() {
      return isSuperAdmin() || isDbAdmin();
    }

    // =========================================================================
    // 👤 User Profiles
    // =========================================================================
    match /users/{userId} {
      // SuperAdmins can always read/write without triggering a self-lookup loop
      allow read, write: if isSuperAdmin();
      
      // Standard rules for others
      allow read: if isOwner(userId) || isDbAdmin(); 
      allow list: if isAdmin(); 
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isDbAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 📦 System Collections
    // =========================================================================

    // Payment Proofs
    match /payment_proofs/{paymentId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    
    // Legacy 'payments'
    match /payments/{paymentId} {
      allow read, write: if isAdmin();
    }

    // Packages & Plans
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Playlists
    match /playlists/{playlistId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid || 
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starCount'])
      );
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Orders
    match /orders/{orderId} {
       allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
       allow create: if isAuthenticated();
       allow update, delete: if isAdmin();
    }

    // Settings & Config
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cms_pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 📊 Admin Dashboard Collections
    // =========================================================================
    
    // Revenue tracking (admin only)
    match /revenue/{revenueId} {
      allow read, write: if isAdmin();
    }
    
    // Subscriptions (admin can read all, users can read their own)
    match /subscriptions/{subscriptionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Dashboard stats (admin only)
    match /dashboard/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Analytics (admin only)
    match /analytics/{docId} {
      allow read, write: if isAdmin();
    }

    // Default: Deny all others
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
